# Copy values into your shell or a local, ignored .env file used by your own launcher.
# The programs intentionally do not load .env files themselves.
UPSTREAM_BASE_URL=https://api.example.com/v1
# UPSTREAM_IP=203.0.113.10
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
MAX_RETRIES=10
# The remaining duration values use Go duration syntax for the standalone build.
# Python's RETRY_BACKOFF accepts seconds instead (for example 0.5).
RETRY_BACKOFF=500ms
REQUEST_TIMEOUT=120s
MAX_RETRY_AFTER=60s
# Optional safety mode: hold SSE output until upstream sends response.completed.
# BUFFER_UNTIL_SUCCESS=true
